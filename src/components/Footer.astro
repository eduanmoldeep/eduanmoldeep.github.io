---
import { LINKEDIN_URL, SITE_TITLE, TRAILBLAZER_URL } from '../consts';

const today = new Date();
---

<footer class="site-footer" id="contact">
	<div class="footer-pitch">
		<p class="footer-kicker">Have a process that’s slow, manual or hard to scale?</p>
		<h2>Let’s design the fix together.</h2>
		<p>
			Agentforce agents, Salesforce integrations, FinTech journeys or a full-time role: tell me what
			you’re trying to solve and I’ll share how I’d approach it.
		</p>
	</div>
	<div class="footer-links">
		<button class="btn btn-accent contact-trigger" type="button" data-open-contact>Discuss your project</button>
		<div class="footer-social">
			<a href={LINKEDIN_URL} target="_blank" rel="noreferrer">LinkedIn ↗</a>
			<a href={TRAILBLAZER_URL} target="_blank" rel="noreferrer">Salesforce Trailblazer ↗</a>
		</div>
		<div class="footer-meta">
			<span>Nagpur, Maharashtra, India · open to remote</span>
		</div>
		<span class="footer-copy">© {today.getFullYear()} {SITE_TITLE}. All rights reserved.</span>
	</div>
</footer>

<dialog class="contact-modal" id="contact-modal" aria-labelledby="contact-title">
	<form
		class="contact-form"
		method="post"
		action={import.meta.env.PUBLIC_FORMSUBMIT_ENDPOINT}
	>
		<div class="contact-header">
			<div>
				<h3 id="contact-title">Tell me about the problem</h3>
				<p class="contact-intro">
					A few lines on the current setup, what’s not working and your timeline is plenty.
				</p>
			</div>
			<button class="contact-close" type="button" data-close-contact>Close</button>
		</div>
		<div class="contact-grid">
			<label>
				Name
				<input name="name" type="text" placeholder="Your full name" required />
			</label>
			<label>
				Work email
				<input name="email" type="email" placeholder="name@company.com" required />
			</label>
			<label>
				Phone
				<input name="phone" type="tel" placeholder="+91 98765 43210" />
			</label>
			<label>
				Company
				<input name="company" type="text" placeholder="Company name" />
			</label>
		</div>
		<label>
			What do you need help with?
			<select name="topic">
				<option value="Agentforce / AI agents">Agentforce / AI agents</option>
				<option value="Salesforce architecture or integration">Salesforce architecture or integration</option>
				<option value="FinTech / lending journey">FinTech / lending journey</option>
				<option value="Custom build beyond Salesforce">Custom build beyond Salesforce</option>
				<option value="Full-time role">Full-time role</option>
				<option value="Something else">Something else</option>
			</select>
		</label>
		<label>
			Message
			<textarea
				name="message"
				rows="5"
				placeholder="What are you trying to solve, and what does success look like?"
				required
			></textarea>
		</label>
		<input type="hidden" name="_subject" value="New enquiry from your portfolio" />
		<!-- Honeypot: hidden field to catch bots — real users leave this blank -->
		<input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
		<button class="btn" type="submit">Send message</button>
	</form>
</dialog>

<script>
	const dialog = document.getElementById('contact-modal');
	const openButtons = document.querySelectorAll('[data-open-contact]');
	const closeButtons = document.querySelectorAll('[data-close-contact]');

	if (dialog instanceof HTMLDialogElement) {
		openButtons.forEach((button) =>
			button.addEventListener('click', () => dialog.showModal()),
		);
		closeButtons.forEach((button) =>
			button.addEventListener('click', () => dialog.close()),
		);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) {
				dialog.close();
			}
		});
	}
</script>
